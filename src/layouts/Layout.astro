---
import "../styles/global.css";

const {title = "Prabhaav Pillai"} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.ico`} />
</head>

<body>

<header>
    <nav>
        <a href={base} class="nav-link">Home</a>
        <a href={`${base}#projects`} class="nav-link">Projects</a>
        <a href={`${base}#papers`} class="nav-link">Papers</a>
        <a href={`${base}#resume`} class="nav-link">Resume</a>
    </nav>
</header>

<main>
    <slot />
</main>

</body>
</html>